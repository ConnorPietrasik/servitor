# servitor.slice — resource slice for servitor.service.
#
# vCPU: as many as physical cores (24), NO quota — a long run should own the
# idle machine. CPUWeight kept low so other host processes are not starved.
# RAM: ceiling 30 GB, not a reservation — MemoryHigh throttles at 25 G so the
# guest degrades before it OOMs; virtio-balloon + free-page-reporting on the
# host side return idle memory; zram absorbs the rest.
[Slice]
CPUWeight=50
MemoryHigh=25G
MemoryMax=30G
