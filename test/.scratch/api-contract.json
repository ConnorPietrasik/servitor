    {"method": "GET",  "path": "/api/v1/sessions/{sid}/files", "params": {}},
    {"method": "POST", "path": "/api/v1/sessions/{sid}/files/upload", "params": {"name": "string(query)"}},
    {"method": "GET",  "path": "/api/v1/sessions/{sid}/files/{path}", "params": {}},
    {"method": "POST", "path": "/panel/sessions/{sid}/action", "params": {"action": "start|steer|prompt|abort|release"}}
  ]
