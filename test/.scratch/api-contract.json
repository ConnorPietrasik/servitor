    {"method": "GET",  "path": "/api/v1/sessions/{sid}", "params": {}},
    {"method": "POST", "path": "/api/v1/sessions/{sid}/prompt", "params": {"text": "string"}},
    {"method": "POST", "path": "/api/v1/sessions/{sid}/steer", "params": {"text": "string"}},
    {"method": "POST", "path": "/api/v1/sessions/{sid}/follow-up", "params": {"text": "string"}},
    {"method": "POST", "path": "/api/v1/sessions/{sid}/abort", "params": {}},
    {"method": "GET",  "path": "/api/v1/sessions/{sid}/probe", "params": {}},
    {"method": "GET",  "path": "/api/v1/sessions/{sid}/messages", "params": {}},
    {"method": "GET",  "path": "/api/v1/sessions/{sid}/tree", "params": {}},
    {"method": "GET",  "path": "/api/v1/sessions/{sid}/fork-messages", "params": {}},
    {"method": "POST", "path": "/api/v1/sessions/{sid}/fork", "params": {"entry_id": "string"}},
    {"method": "POST", "path": "/api/v1/sessions/{sid}/switch", "params": {"session_path": "string"}},
    {"method": "POST", "path": "/api/v1/sessions/{sid}/stable", "params": {"stable": "bool"}},
    {"method": "POST", "path": "/api/v1/sessions/{sid}/release", "params": {}},
