# secrets — never in git
.env

# python
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# node (conformance scratch prefixes, ui)
node_modules/
ui/node_modules/
ui/dist/

# dev state
*.log

# ui build stamp (the ui/ source sha the dist was built from)
ui/.ui-src-sha

# guest image artifacts (large; reproducible via deploy/guest/build.sh).
# manifest.json included: it is local to the build host, not versioned —
# a fresh checkout gets its manifest from the first `make guest`
deploy/guest/images/*
