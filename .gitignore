# secrets — never in git
.env

# python
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# node (conformance scratch prefixes, ui)
node_modules/
# scratch contents are gitignored, EXCEPT the versioned API contract
# (test_contract.py diffs the live app's route set against it)
test/.scratch/*
!test/.scratch/api-contract.json
test/.scratch2/
ui/node_modules/
ui/dist/

# dev state
test/.state/
*.log

# ui build stamp (the ui/ source sha the dist was built from)
ui/.ui-src-sha

# guest image artifacts (large; reproducible via deploy/guest/build.sh).
# manifest.json included: it is local to the build host, not versioned —
# a fresh checkout gets its manifest from the first `make guest`
deploy/guest/images/*
