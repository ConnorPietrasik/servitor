# secrets — never in git
.env

# python
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# node (conformance scratch prefixes, ui)
node_modules/
# scratch contents are gitignored, EXCEPT the versioned API contract
# (test_contract.py diffs the live app's route set against it)
test/.scratch/*
!test/.scratch/api-contract.json
test/.scratch2/
ui/node_modules/
ui/dist/

# dev state
test/.state/
*.log

# guest image artifacts (large; reproducible via deploy/guest/build.sh —
# only the manifest's identity record is versioned)
deploy/guest/images/*
!deploy/guest/images/manifest.json
