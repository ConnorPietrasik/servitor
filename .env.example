# Servitor — environment contract. This file is the COMPLETE record of the
# host `.env`: every env var the app reads (the sections below — gated by
# test/check_contract.py against app/env.py) plus the host-side deploy
# section at the bottom (read by deploy/*.sh and the guest image build —
# never by the app, never synced into the guest). Copy to `.env` for dev or
# for the host checkout; the guest's copy (/etc/servitor/servitor.env,
# mode 0600) holds only the app-contracted names.
#
# Values below the defaults are the settled values; the file may
# omit any non-REQUIRED line. Secrets have NO defaults and are the only
# secrets: the key is env-only per subprocess (invariant 5) and never lands
# on disk in the VM.
#
# One KEY=value per line, NO inline comments: the deploy scripts source
# the file (bash drops a trailing comment), but panel-do's servitor-status
# healthz probe parses it literally — a trailing comment becomes part of
# the value and the probe degrades (its inputs are SERVITOR_BIND /
# SERVITOR_PORT).

# --- Machine credentials (the only secrets) -------------------------------
# REQUIRED. Router bearer key; the host's LLM_API_KEY. Env-only:
# passed to each pi subprocess by env, never on argv, never synced, never
# logged.
OMNISSIAH_API_KEY=
# REQUIRED with the search extension. Exa key; env-first in pi-web-access
# 0.47.0 (verified §4) — beats any web-search.json literal, so servitor never
# writes a key file.
EXA_API_KEY=

# --- Network contract (the edge is the only auth gate) --------------------
# REQUIRED. Address the app binds: production = the VM ingress interface
# (the address the edge route targets); standalone/loopback dev = 127.0.0.1.
SERVITOR_BIND=
# REQUIRED. The one published port. Settled: 8787 (the VM port space is
# dedicated; unique inside the VM is all that is needed).
SERVITOR_PORT=8787
# REQUIRED on the guest. CIDR; the ONLY subnet admitted SERVITOR_PORT by the
# guest firewall. Production: the host's edge network subnet, derived, not
# hardcoded (`docker network inspect edge -f Subnet`).
SERVITOR_EDGE_SUBNET=
# REQUIRED on the guest. CIDR; ops SSH (tcp/22) admitted from this subnet.
SERVITOR_OPS_SUBNET=
# Optional. The single browser origin (scheme+host+port) allowed to use the
# API from a web page (CORS allow-list; exact match, never *). The chat UI
# is served from this origin; the browser holds the API key in
# sessionStorage. Empty = API-only (no browser CORS).
SERVITOR_BROWSER_ORIGIN=

# --- State volume ----------------------------------------------------------
# REQUIRED. The state volume root — a real ext4 filesystem, never
# container/overlay storage (T29; the boot assert checks findmnt/stat -f).
# Guest: /var/lib/servitor (sized at VM creation, ~200 GB). Laptop dev: any
# ext4 path, e.g. /home/<user>/servitor-state.
SERVITOR_ROOT=/var/lib/servitor

# --- Lifecycle / delivery (ops parameters — never capability caps) -----
# Idle GC: release sessions idle longer than this many days that are not
# stable and not running. Settled: 14.
SERVITOR_GC_IDLE_DAYS=14
# App-shutdown abort-then-drain grace. Strictly less than the unit's
# TimeoutStopSec (120) or systemd escalates mid-drain and the recorded cause
# lies. Settled: 90.
SERVITOR_DRAIN_GRACE_SECS=90
# Wire coalesce: thinking/text deltas are batched into flushes of this many
# ms (per-subscriber ?coalesce= overrides). Delivery batching only — the run
# is byte-identical. Settled: 1000.
SERVITOR_COALESCE_MS=1000
# SSE keepalive ping interval (comment line). Carries long silent gaps — a
# 20-minute bash call emits no events — through proxy idle timeouts.
# A cut connection is still harmless (reattach is a fetch). Settled: 15.
SERVITOR_HEARTBEAT_SECS=15
# Per-session SSE delivery buffer cap in bytes (a MEMORY bound, never a
# capability cap: past it the run PAUSES, it is never cut off or
# truncated). The slowest live consumer is never evicted; the ring holds
# at most this plus one in-flight event. Empty = the 50 MB default.
# Tune down for low-RAM hosts; tune up only if you want longer resume
# windows for a very slow consumer. 50*1024*1024 = 52428800.
SERVITOR_SSE_RING_BYTES=

# --- Version selections (npm semver specs; exact by default) ----------
# The conformance suite + doctor are the control; the value is only where
# the choice is recorded. Not bumping is a supported steady state.
SERVITOR_PI_VERSION=1.5.2
SERVITOR_PI_WEB_ACCESS_VERSION=0.47.0

# --- Deployment layout (absolute paths; the guest unit passes them) ------
# Absolute node binary (never PATH resolution at spawn time).
# Guest: /usr/bin/node. Laptop dev: the node on PATH, by absolute path.
SERVITOR_PI_NODE_BIN=
# Absolute pi CLI entry (the installed package's dist/cli.js). Never a
# `pi` on PATH: the spawn line is golden-asserted by doctor.
SERVITOR_PI_CLI_JS=
# Absolute pi-web-access package dir. Owned by the sync pipeline
# (host npm stage + rename); NOT baked into the image.
SERVITOR_PI_EXT_DIR=
# Absolute toolkit dir (the RO overlay lower for every session): python
# env + ffmpeg/imagemagick/yt-dlp/ripgrep/uv. Must contain no context
# files at its root (doctor asserts).
SERVITOR_TOOLKIT_DIR=
# cwd for the doctor command the app's update tick runs (the app tree).
SERVITOR_DOCTOR_CWD=

# --- Deploy-time intent (runtime discovery, asserted by doctor) ----------
# The intended model, as served by the router at deploy time. doctor asserts
# the live get_available_models + model id + context window against these —
# never hardcoded in code. Discovered 2026-11-14 on the owner's network:
# qwen35 (Qwen 3.8 27B), 250000 context.
SERVITOR_INTENDED_MODEL_ID=qwen35
SERVITOR_INTENDED_CONTEXT_WINDOW=250000

# --- Host-side deploy (read by the deploy scripts, never by the app) ------
# These complete the host .env but are outside the app contract on purpose:
# the app never reads them, and sync.sh's key slice never carries them into
# the guest — the image build bakes them in instead. test/check_contract.py
# asserts the set via app.env.HOST_DEPLOY_ENV_NAMES (disjoint from
# ENV_NAMES).
# REQUIRED (host). The VM's edge address: an unused address in the edge
# subnet, CHOSEN BEFORE `make guest` (it is baked into the image) and used
# by deploy/sync|doctor|update.sh as the ssh target.
SERVITOR_VM_IP=
# REQUIRED for `make guest`. Public DNS upstreams for the guest (no DHCP on
# the edge bridge; public resolvers ride the host NAT). QUOTED — the deploy
# scripts source this file, so an unquoted multi-word value would make bash
# execute the second token.
SERVITOR_DNS_UPSTREAM="1.1.1.1 9.9.9.9"

